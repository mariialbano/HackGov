node_modules
# Default ignored files
/shelf/
/workspace.xml

# Ignorar dependências instaladas (elas são baixadas de novo com npm install)
**/node_modules/
frontend/dist/

# IGNORAR ARQUIVOS SECRETOS (SEGURANÇA DA API KEY)
backend/.env
.env
.idea/

# Estado de execucao dos scripts iniciar/parar
.run/

# Banco de dados local (H2 em arquivo): e dado de execucao, nao codigo.
# O schema.sql recria as tabelas em qualquer maquina.
backend/data/

# Configuracao local do Claude Code, nao faz parte do projeto.
.claude/

# Backups do banco (contem dados dos cidadaos): nunca versionar
backend/backups/

# PDF do documento tecnico: gerado localmente a partir de docs/relatorio-visao-de-futuro.html
docs/*.pdf
