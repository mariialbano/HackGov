# Modelo de configuracao do backend (VidaReal API - Spring Boot).
# Copie este arquivo para ".env" e preencha os valores.
# O .env real NUNCA deve ser versionado (ja esta no .gitignore).
#
# Estas variaveis sao lidas como variaveis de ambiente. No Windows:
#   $env:IA_API_KEY="sua_chave"; mvn spring-boot:run

# Chave da API do Google Gemini - usada pelo assistente virtual (chatbot).
# Gere em: https://aistudio.google.com/apikey
# Sem ela, todo o resto do sistema funciona; apenas o chatbot fica indisponivel.
IA_API_KEY=sua_chave_aqui

# Opcional: porta do servidor (padrao 3001).
# PORT=3001
