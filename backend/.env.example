# Modelo de configuracao do backend (VidaReal API - Spring Boot).
# Copie este arquivo para ".env" e preencha os valores.
# O .env real NUNCA deve ser versionado (ja esta no .gitignore).
#
# Estas variaveis sao lidas como variaveis de ambiente. O start.ps1 e o
# rodar.ps1 carregam o .env automaticamente. Escreva cada valor direto
# depois do "=", sem aspas.

# ---------------------------------------------------------------
# E-mail (SMTP) - usado na recuperacao de senha
# ---------------------------------------------------------------
# Sem estas variaveis, todo o resto do sistema funciona; apenas o
# "Esqueci minha senha" responde que esta indisponivel.
#
# Exemplo com o Gmail:
#   1. Ative a verificacao em duas etapas na conta Google.
#   2. Gere uma "senha de app" em https://myaccount.google.com/apppasswords
#   3. Use essa senha de 16 letras em SMTP_PASSWORD, sem os espacos.
#      A senha normal da conta NAO funciona aqui.
#
# A conta abaixo e apenas o REMETENTE. Os cidadaos podem ter e-mail em
# qualquer provedor (Gmail, Outlook, Yahoo...).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=sua_conta@gmail.com
SMTP_PASSWORD=sua_senha_de_app

# Opcional: endereco exibido como remetente (padrao: o proprio SMTP_USER).
# No Gmail precisa ser a propria conta.
# SMTP_FROM=sua_conta@gmail.com

# Opcional: e-mails das contas de demonstracao (Maria e Joao). O padrao usa
# o dominio example.com, que nunca entrega. Para testar a recuperacao com
# esses usuarios, informe enderecos seus. Vale para um banco novo, ou para
# uma conta de demonstracao que ainda nao tenha e-mail.
# DEMO_EMAIL_CIDADAO=seu_email@gmail.com
# DEMO_EMAIL_ATENDENTE=outro_email@gmail.com

# ---------------------------------------------------------------
# Assistente virtual (chatbot)
# ---------------------------------------------------------------
# Chave da API do Google Gemini. Gere em: https://aistudio.google.com/apikey
# Sem ela, todo o resto do sistema funciona; apenas o chatbot fica indisponivel.
IA_API_KEY=sua_chave_aqui

# Opcional: porta do servidor (padrao 3001).
# PORT=3001
