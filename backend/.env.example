# Modelo de configuração do backend.
# Copie este arquivo para ".env" e preencha os valores.
# O .env real NUNCA deve ser versionado (já está no .gitignore).

# Chave da API do Google Gemini — usada pelo assistente virtual (chatbot).
# Gere em: https://aistudio.google.com/apikey
# Sem ela, todo o resto do sistema funciona; apenas o chatbot fica indisponível.
IA_API_KEY=sua_chave_aqui

# Opcional: modelo de IA usado pelo chatbot.
# Padrão: gemini-flash-latest. Troque se o modelo estiver sobrecarregado.
# IA_MODELO=gemini-2.5-flash-lite

# Opcional: porta do servidor (padrão 3001).
# PORT=3001

# Opcional: origens autorizadas a chamar a API, separadas por vírgula.
# Padrão: http://localhost:5173
# Em produção, informe a URL do front-end publicado.
# ORIGENS_PERMITIDAS=https://hackgov.onrender.com
